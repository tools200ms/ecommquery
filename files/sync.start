#!/bin/sh

cd /srv

touch poetry.lock && chown user poetry.lock
su user -c "poetry lock --regenerate"
mkdir -p ./logs && chown user ./logs

su user -c "poetry install" > /srv/logs/install.out 2>&1

# Watchdog:
#     ps -o comm,args | grep -q -e "^python.*ecommquery"
# Missing INIT - let's do 'python' init
$(su user -c "cd /srv; poetry run python ./tasks/main.py" > /srv/logs/run.out 2>&1)&

exit 0
